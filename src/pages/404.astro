---
import Base from '../layouts/Base.astro';
import SectionTitle from '../components/SectionTitle.astro';
import { getLocaleFromPath, t, withLocale } from '../lib/i18n';

const locale = Astro.locals.locale ?? getLocaleFromPath(Astro.url.pathname);
const homeHref = withLocale(locale, '/');
---

<Base title={t(locale, 'notFound.pageTitle')} locale={locale}>
  <section class="py-24">
    <div class="max-w-3xl mx-auto px-6">
      <div class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-card)]/90 p-8 md:p-10 shadow-sm text-center">
        <p class="text-7xl font-bold text-[var(--color-brand-light)] mb-4 brand-display">404</p>
        <div class="flex justify-center mb-3">
          <SectionTitle title={t(locale, 'notFound.title')} icon="tag" />
        </div>
        <p class="text-[var(--color-text-secondary)] mb-8">{t(locale, 'notFound.blurb')}</p>
        <a href={homeHref} class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-[var(--color-brand)] text-[#070b12] text-sm font-semibold hover:opacity-90 transition-opacity">
          {t(locale, 'notFound.back')}
        </a>
      </div>
    </div>
  </section>
</Base>
