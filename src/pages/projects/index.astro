---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import WorkCard from '../../components/WorkCard.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import { getCollection } from 'astro:content';
import { filterVisibleWorks } from '../../lib/content';

const user = Astro.locals.user;
const isAuthed = Boolean(user);

const allWorks = await getCollection('works');
const worksList = filterVisibleWorks(allWorks, isAuthed).sort(
  (a, b) => a.data.order - b.data.order,
);
const privateWorkCount = isAuthed
  ? 0
  : allWorks.filter((w) => w.data.visibility === 'private').length;

const allProjects = isAuthed
  ? (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order)
  : [];

const typeLabels: Record<string, string> = {
  demo: 'Demo',
  design: '设计',
  talk: '演讲',
  article: '文章',
  repo: '仓库',
  other: '其他',
};
---

<Base title="项目 - AI Kosei" description="公开作品与授权项目概要" variant={isAuthed ? 'console' : 'public'}>
  <section class="py-16">
    <div class="max-w-5xl mx-auto px-6">
      <SectionTitle title="项目" subtitle="作品与概要" icon="projects" />
      <p class="text-sm text-[var(--color-text-secondary)] mt-2 mb-10 pl-9">
        公开作品可直接浏览；职业项目概要仅授权访客可见，且只到摘要级。
      </p>

      <div id="works" class="mb-14">
        <div class="flex items-end justify-between gap-4 mb-6">
          <SectionTitle title="作品" subtitle={isAuthed ? '全部作品' : '公开展示'} icon="works" />
        </div>
        <p class="text-sm text-[var(--color-text-secondary)] -mt-4 mb-6 pl-9">
          {isAuthed
            ? '含公开与仅授权可见的作品条目。'
            : '以下为公开作品。登录后可查看完整作品库。'}
        </p>

        {worksList.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {worksList.map((work) => (
              <WorkCard
                title={work.data.title}
                description={work.data.description}
                type={typeLabels[work.data.type] ?? work.data.type}
                typeKey={work.data.type}
                slug={work.id}
                url={work.data.url}
                publicBadge={work.data.visibility === 'public'}
              />
            ))}
          </div>
        ) : (
          <p class="text-[var(--color-text-muted)]">暂无公开展示的作品。</p>
        )}

        {!isAuthed && privateWorkCount > 0 && (
          <p class="text-sm text-[var(--color-text-muted)] mt-6">
            另有 {privateWorkCount} 项需
            <a href="/login?next=/projects/" class="text-[var(--color-brand)] hover:underline">登录</a>
            查看。
          </p>
        )}
      </div>

      <div id="briefs">
        <div class="flex items-end justify-between gap-4 mb-6">
          <SectionTitle title="项目概要" subtitle="任务编队" icon="projects" />
        </div>
        {isAuthed ? (
          <>
            <p class="text-sm text-[var(--color-text-secondary)] -mt-4 mb-6 pl-9">仅含总结与设计方案简述，不含实现细节。</p>
            <div class="hud-panel">
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                {allProjects.map((project) => (
                  <a href={`/projects/${project.id}/`} class="block">
                    <ProjectCard
                      title={project.data.title}
                      description={project.data.description}
                      tech={project.data.tech}
                      image={project.data.image}
                    />
                  </a>
                ))}
              </div>
            </div>
          </>
        ) : (
          <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-card)]/90 p-6">
            <p class="text-sm text-[var(--color-text-secondary)] mb-4">
              职业项目概要需 GitHub 白名单登录后查看。
            </p>
            <a
              href="/login?next=/projects/"
              class="inline-flex items-center px-4 py-2 rounded-lg bg-[var(--color-brand)] text-[#070b12] text-sm font-semibold hover:opacity-90 transition-opacity"
            >
              登录查看项目概要
            </a>
          </div>
        )}
      </div>
    </div>
  </section>
</Base>
