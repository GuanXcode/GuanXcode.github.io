---
export const prerender = false;

import Base from '../../../layouts/Base.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import WorkCard from '../../../components/WorkCard.astro';
import SectionTitle from '../../../components/SectionTitle.astro';
import { getCollection } from 'astro:content';
import { filterVisibleWorks } from '../../../lib/content';
import { t, withLocale } from '../../../lib/i18n';

const locale = 'en' as const;
const user = Astro.locals.user;
const isAuthed = Boolean(user);

const allWorks = await getCollection('works');
const worksList = filterVisibleWorks(allWorks, isAuthed).sort(
  (a, b) => a.data.order - b.data.order,
);
const privateWorkCount = isAuthed
  ? 0
  : allWorks.filter((w) => w.data.visibility === 'private').length;

const allProjects = isAuthed
  ? (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order)
  : [];

const typeKeyMap = {
  demo: 'type.demo',
  design: 'type.design',
  talk: 'type.talk',
  article: 'type.article',
  repo: 'type.repo',
  other: 'type.other',
} as const;

function typeLabel(type: string) {
  const key = typeKeyMap[type as keyof typeof typeKeyMap];
  return key ? t(locale, key) : type;
}

const loginNext = withLocale(locale, '/projects/');
const loginHref = `${withLocale(locale, '/login')}?next=${encodeURIComponent(loginNext)}`;
const contentNote = t(locale, 'projects.contentNote');
---

<Base
  title={t(locale, 'projects.pageTitle')}
  description={t(locale, 'projects.pageDesc')}
  variant={isAuthed ? 'console' : 'public'}
  locale={locale}
>
  <section class="py-16">
    <div class="max-w-5xl mx-auto px-6">
      <SectionTitle title={t(locale, 'projects.title')} subtitle={t(locale, 'projects.subtitle')} icon="projects" />
      <p class="text-sm text-[var(--color-text-secondary)] mt-2 mb-10 pl-9">
        {t(locale, 'projects.desc')}
      </p>

      {contentNote && <p class="content-lang-note">{contentNote}</p>}

      <div id="works" class="mb-14">
        <div class="flex items-end justify-between gap-4 mb-6">
          <SectionTitle
            title={t(locale, 'projects.works')}
            subtitle={isAuthed ? t(locale, 'projects.worksAll') : t(locale, 'projects.worksPublic')}
            icon="works"
          />
        </div>
        <p class="text-sm text-[var(--color-text-secondary)] -mt-4 mb-6 pl-9">
          {isAuthed ? t(locale, 'projects.worksAuthedHint') : t(locale, 'projects.worksGuestHint')}
        </p>

        {worksList.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {worksList.map((work) => (
              <WorkCard
                title={work.data.title}
                description={work.data.description}
                type={typeLabel(work.data.type)}
                typeKey={work.data.type}
                slug={work.id}
                url={work.data.url}
                publicBadge={work.data.visibility === 'public'}
              />
            ))}
          </div>
        ) : (
          <p class="text-[var(--color-text-muted)]">{t(locale, 'projects.worksEmpty')}</p>
        )}

        {!isAuthed && privateWorkCount > 0 && (
          <p class="text-sm text-[var(--color-text-muted)] mt-6">
            {t(locale, 'projects.worksMorePrefix', { n: privateWorkCount })}{' '}
            <a href={loginHref} class="text-[var(--color-brand)] hover:underline">{t(locale, 'projects.login')}</a>
            {t(locale, 'projects.worksMoreSuffix')}
          </p>
        )}
      </div>

      <div id="briefs">
        <div class="flex items-end justify-between gap-4 mb-6">
          <SectionTitle title={t(locale, 'projects.briefs')} subtitle={t(locale, 'projects.briefsSub')} icon="projects" />
        </div>
        {isAuthed ? (
          <>
            <p class="text-sm text-[var(--color-text-secondary)] -mt-4 mb-6 pl-9">{t(locale, 'projects.briefsHint')}</p>
            <div class="">
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                {allProjects.map((project) => (
                  <a href={withLocale(locale, `/projects/${project.id}/`)} class="block">
                    <ProjectCard
                      title={project.data.title}
                      description={project.data.description}
                      tech={project.data.tech}
                      image={project.data.image}
                    />
                  </a>
                ))}
              </div>
            </div>
          </>
        ) : (
          <div class="p-6">
            <p class="text-sm text-[var(--color-text-secondary)] mb-4">
              {t(locale, 'projects.briefsLocked')}
            </p>
            <a
              href={loginHref}
              class="inline-flex items-center px-4 py-2 rounded-lg bg-[var(--color-brand)] text-[#070b12] text-sm font-semibold hover:opacity-90 transition-opacity"
            >
              {t(locale, 'projects.briefsLogin')}
            </a>
          </div>
        )}
      </div>
    </div>
  </section>
</Base>
