---
export const prerender = false;

import Base from '../../../layouts/Base.astro';
import SectionTitle from '../../../components/SectionTitle.astro';
import Timeline from '../../../components/Timeline.astro';
import { getCollection, render } from 'astro:content';
import { withLocale } from '../../../lib/i18n';

const locale = 'en' as const;

const experiences = (await getCollection('experience')).sort(
  (a, b) => a.data.order - b.data.order,
);

const experienceEntries = await Promise.all(
  experiences.map(async (exp) => {
    const { Content } = await render(exp);
    return { exp, Content };
  }),
);
---

<Base title="Experience - AI Kosei" variant="console" locale={locale}>
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-6">
      <a href={withLocale(locale, '/me/')} class="inline-flex text-sm text-[var(--color-text-muted)] hover:text-[var(--color-brand)] mb-6">&larr; Back to resume</a>
      <p class="content-lang-note mb-6">Experience detail content is currently in Chinese.</p>
      <SectionTitle title="Experience" subtitle="Career timeline" icon="timeline" />
      <div class="hud-panel mt-8">
      <p class="text-sm text-[var(--color-text-secondary)] mb-8">Full employment record (authorized visitors).</p>

      {experienceEntries.length > 0 ? (
        <Timeline entries={experienceEntries} />
      ) : (
        <p class="text-[var(--color-text-muted)] text-sm">No experience entries yet.</p>
      )}
      </div>
    </div>
  </section>
</Base>
