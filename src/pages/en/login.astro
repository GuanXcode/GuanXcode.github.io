---
import Base from '../../layouts/Base.astro';
import LoginGate from '../../components/LoginGate.astro';
import { t, withLocale } from '../../lib/i18n';

export const prerender = false;

const locale = 'en' as const;
const error = Astro.url.searchParams.get('error');
const next = Astro.url.searchParams.get('next') ?? withLocale(locale, '/me/');
---

<Base
  title={t(locale, 'login.pageTitle')}
  description={t(locale, 'login.pageDesc')}
  variant="gate"
  locale={locale}
>
  <LoginGate locale={locale} error={error} next={next} />
</Base>
