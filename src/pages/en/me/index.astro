---
export const prerender = false;

import Base from '../../../layouts/Base.astro';
import ProfileHeader from '../../../components/ProfileHeader.astro';
import Skills from '../../../components/Skills.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import WorkCard from '../../../components/WorkCard.astro';
import SectionTitle from '../../../components/SectionTitle.astro';
import { getCollection } from 'astro:content';
import { t, withLocale } from '../../../lib/i18n';

const locale = 'en' as const;
const user = Astro.locals.user!;

const allProjects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
const featuredProjects = allProjects.filter((p) => p.data.featured);
const displayProjects =
  featuredProjects.length > 0 ? featuredProjects : allProjects.slice(0, 3);

const experiences = (await getCollection('experience')).sort(
  (a, b) => b.data.order - a.data.order,
);

const privateWorks = (await getCollection('works'))
  .filter((w) => w.data.visibility === 'private')
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const skills = [
  {
    title: t(locale, 'skill.agent.title'),
    items: [t(locale, 'skill.agent.i0'), t(locale, 'skill.agent.i1'), t(locale, 'skill.agent.i2'), t(locale, 'skill.agent.i3')],
  },
  {
    title: t(locale, 'skill.rag.title'),
    items: [t(locale, 'skill.rag.i0'), t(locale, 'skill.rag.i1'), t(locale, 'skill.rag.i2'), t(locale, 'skill.rag.i3')],
  },
  {
    title: t(locale, 'skill.eval.title'),
    items: [t(locale, 'skill.eval.i0'), t(locale, 'skill.eval.i1'), t(locale, 'skill.eval.i2'), t(locale, 'skill.eval.i3')],
  },
  {
    title: t(locale, 'skill.arch.title'),
    items: [t(locale, 'skill.arch.i0'), t(locale, 'skill.arch.i1'), t(locale, 'skill.arch.i2'), t(locale, 'skill.arch.i3')],
  },
];
---

<Base title="Resume - AI Kosei" variant="console" locale={locale}>
  <ProfileHeader user={user} />

  {experiences.length > 0 && (
    <section class="py-16">
      <div class="max-w-5xl mx-auto px-6">
        <div class="flex items-center justify-between mb-6">
          <SectionTitle title="Experience" subtitle="Career timeline" icon="timeline" />
          <a href={withLocale(locale, '/experience/')} class="text-sm text-[var(--color-brand)] hover:underline">Full experience &rarr;</a>
        </div>
        <ul>
          {experiences.slice(0, 2).map((exp) => (
            <li class="py-5">
              <div class="flex flex-wrap justify-between gap-2 mb-1">
                <h3 class="font-semibold">{exp.data.company}</h3>
                <span class="text-sm text-[var(--color-text-muted)]">
                  {exp.data.start}{exp.data.end ? ` — ${exp.data.end}` : ''}
                </span>
              </div>
              <p class="text-sm text-[var(--color-brand)] mb-2">{exp.data.role}</p>
              {exp.data.highlights[0] && (
                <p class="text-sm text-[var(--color-text-secondary)]">{exp.data.highlights[0]}</p>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {displayProjects.length > 0 && (
    <section id="projects" class="py-16">
      <div class="max-w-5xl mx-auto px-6">
        <div class="flex items-center justify-between mb-8">
          <SectionTitle title="Projects" subtitle="Task formation · briefs" icon="projects" />
          <a href={withLocale(locale, '/projects/')} class="text-sm text-[var(--color-brand)] hover:underline">All projects &rarr;</a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {displayProjects.map((project) => (
            <a href={withLocale(locale, `/projects/${project.id}/`)} class="block">
              <ProjectCard
                title={project.data.title}
                description={project.data.description}
                tech={project.data.tech}
                image={project.data.image}
              />
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {privateWorks.length > 0 && (
    <section class="py-16">
      <div class="max-w-5xl mx-auto px-6">
        <div class="flex items-center justify-between mb-8">
          <SectionTitle title="Works" subtitle="Authorized only" icon="works" />
          <a href={withLocale(locale, '/projects/#works')} class="text-sm text-[var(--color-brand)] hover:underline">All works &rarr;</a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {privateWorks.map((work) => (
            <WorkCard
              title={work.data.title}
              description={work.data.description}
              type={work.data.type}
              slug={work.id}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <section id="skills" class="py-20">
    <div class="max-w-5xl mx-auto px-6">
      <SectionTitle title="Skills" subtitle="AI Native · capability map" icon="skills" />
      <div class="mt-8">
      <div class="grid grid-cols-1 lg:grid-cols-[320px_1fr] gap-6 items-stretch">
        <aside class="radar-panel">
          <div class="radar-grid">
            <span class="radar-hex h1"></span>
            <span class="radar-hex h2"></span>
            <span class="radar-hex h3"></span>
            <span class="radar-scan"></span>
            <span class="radar-core"></span>
            <span class="radar-dot d1"></span>
            <span class="radar-dot d2"></span>
            <span class="radar-dot d3"></span>
            <span class="radar-dot d4"></span>
          </div>
          <p class="text-xs text-[var(--color-text-secondary)] mt-4">Capability matrix online</p>
        </aside>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 h-full">
          {skills.map((s, i) => <Skills title={s.title} items={s.items} index={i} />)}
        </div>
      </div>
      </div>
    </div>
  </section>
</Base>
