---
import {
  getLocaleFromPath,
  htmlLang,
  switchLocalePath,
  t,
  withLocale,
  type Locale,
} from '../lib/i18n';
import { LOCALE_COOKIE } from '../lib/i18n';

interface Props {
  title: string;
  description?: string;
  fullWidth?: boolean;
  compactFooter?: boolean;
  variant?: 'public' | 'console' | 'gate';
  wide?: boolean;
  locale?: Locale;
}

const {
  title,
  fullWidth = false,
  compactFooter = false,
  variant = 'public',
  wide = false,
  locale: localeProp,
} = Astro.props;

const locale: Locale = localeProp ?? Astro.locals.locale ?? getLocaleFromPath(Astro.url.pathname);
const description = Astro.props.description ?? t(locale, 'meta.defaultDescription');
const user = Astro.locals.user;
const shellClass = fullWidth
  ? (compactFooter ? 'w-full px-3 sm:px-4' : 'w-full px-4 sm:px-6 lg:px-8')
  : `${wide ? 'max-w-6xl' : 'max-w-5xl'} mx-auto px-6`;
const isConsole = variant === 'console';
const isGate = variant === 'gate';
const path = Astro.url.pathname;
const bare = path.replace(/^\/en(?=\/|$)/, '') || '/';
const navHome = bare === '/' || bare === '';
const navResume = bare.startsWith('/me') || bare.startsWith('/experience');
const navResearch = bare.startsWith('/research') || bare.startsWith('/blog');
const navProjects = bare.startsWith('/projects') || bare.startsWith('/works');
const navLink = (active: boolean) =>
  active
    ? 'text-sm text-[var(--color-text)]'
    : 'text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-text)] transition-colors';

const homeHref = withLocale(locale, '/');
const meHref = withLocale(locale, '/me/');
const researchHref = withLocale(locale, '/research/');
const projectsHref = withLocale(locale, '/projects/');
const zhHref = switchLocalePath(path, 'zh');
const enHref = switchLocalePath(path, 'en');

Astro.cookies.set(LOCALE_COOKIE, locale, {
  path: '/',
  maxAge: 60 * 60 * 24 * 365,
  sameSite: 'lax',
  httpOnly: false,
});

import '../styles/global.css';
---

<!doctype html>
<html lang={htmlLang(locale)} data-shell={variant} data-locale={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="keywords" content={t(locale, 'meta.keywords')} />
    <meta name="theme-color" content="#070b12" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/img/apple-touch-icon.png" />
    <link rel="alternate" hreflang="zh-CN" href={new URL(zhHref, Astro.site ?? Astro.url.origin).href} />
    <link rel="alternate" hreflang="en" href={new URL(enHref, Astro.site ?? Astro.url.origin).href} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="sticky top-0 z-50 bg-[var(--color-bg)]/80 backdrop-blur-md border-b border-[var(--color-border)]">
      <nav class={`${shellClass} h-16 flex items-center justify-between gap-3`}>
        <a href={homeHref} class="flex items-center gap-3 text-[var(--color-text)] hover:text-[var(--color-brand-light)] transition-colors shrink-0">
          <img src="/img/logo-kosei.svg" alt="AI Kosei" class="w-8 h-8 rounded-lg" />
          <span class="brand-display font-bold text-base md:text-lg">AI Kosei</span>
          {isConsole && <span class="nav-auth-pill hidden sm:inline">Authed</span>}
          {isGate && <span class="nav-auth-pill hidden sm:inline">Gate</span>}
        </a>
        <div class="flex items-center gap-4 md:gap-6 min-w-0">
          <a href={homeHref} class={navLink(navHome)} aria-current={navHome ? 'page' : undefined}>{t(locale, 'nav.home')}</a>
          <a href={meHref} class={navLink(navResume)} aria-current={navResume ? 'page' : undefined}>{t(locale, 'nav.resume')}</a>
          <a href={researchHref} class={navLink(navResearch)} aria-current={navResearch ? 'page' : undefined}>{t(locale, 'nav.research')}</a>
          <a href={projectsHref} class={navLink(navProjects)} aria-current={navProjects ? 'page' : undefined}>{t(locale, 'nav.projects')}</a>
          <div class="lang-switch" role="group" aria-label="Language">
            <a
              href={zhHref}
              class:list={['lang-switch-btn', locale === 'zh' && 'is-active']}
              aria-current={locale === 'zh' ? 'true' : undefined}
              title={t(locale, 'nav.switchToZh')}
            >{t(locale, 'nav.langZh')}</a>
            <a
              href={enHref}
              class:list={['lang-switch-btn', locale === 'en' && 'is-active']}
              aria-current={locale === 'en' ? 'true' : undefined}
              title={t(locale, 'nav.switchToEn')}
            >{t(locale, 'nav.langEn')}</a>
          </div>
          {user && (
            <a href="/auth/logout" class="text-sm text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors">{t(locale, 'nav.logout')}</a>
          )}
        </div>
      </nav>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class={`border-t border-[var(--color-border)] ${compactFooter ? 'py-4 mt-0' : 'py-8 mt-20'}`}>
      <div class={`${shellClass} text-center text-sm text-[var(--color-text-muted)]`}>
        <p>{t(locale, 'footer.copy')}</p>
      </div>
    </footer>

    <button id="support-btn" aria-label={t(locale, 'support.open')} aria-expanded="false" class="support-fab" type="button">
      <span class="support-fab-glow" aria-hidden="true"></span>
      <svg class="support-fab-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <rect x="3.5" y="4.5" width="17" height="15" rx="2" stroke="currentColor" stroke-width="1.6"/>
        <path d="M7.25 10.25l2.6 2.25-2.6 2.25" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M12.25 14.75H16.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
      </svg>
    </button>

    <div id="support-modal" class="support-modal hidden" role="dialog" aria-modal="true" aria-labelledby="support-title">
      <div class="support-card">
        <div class="flex items-center justify-between mb-3">
          <h3 id="support-title" class="font-semibold text-[var(--color-text)]">{t(locale, 'support.title')}</h3>
          <button id="support-close" type="button" class="text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors" aria-label={t(locale, 'support.close')}>✕</button>
        </div>
        <p class="text-sm text-[var(--color-text-secondary)] mb-4">{t(locale, 'support.blurb')}</p>
        <div class="space-y-2">
          <a href="mailto:guanx214@gmail.com" class="support-link">
            <span class="support-link-left">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              <span>{t(locale, 'support.email')}</span>
            </span>
            <span class="font-mono text-xs">guanx214@gmail.com</span>
          </a>
          <a href="https://github.com/GuanXcode" target="_blank" rel="noopener noreferrer" class="support-link">
            <span class="support-link-left">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
              <span>{t(locale, 'support.github')}</span>
            </span>
            <span class="font-mono text-xs">github.com/GuanXcode</span>
          </a>
          <a href="https://agentdev.online" target="_blank" rel="noopener noreferrer" class="support-link">
            <span class="support-link-left">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M3.6 9h16.8M3.6 15h16.8M12 3a15 15 0 010 18M12 3a15 15 0 000 18"/></svg>
              <span>{t(locale, 'support.website')}</span>
            </span>
            <span class="font-mono text-xs">agentdev.online</span>
          </a>
          <button type="button" id="support-wechat" class="support-link" data-wechat-id="a39085417" aria-label={t(locale, 'support.wechatCopy')}>
            <span class="support-link-left">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M8.691 2.188C3.891 2.188 0 5.476 0 9.53c0 2.212 1.17 4.203 3.002 5.55a.59.59 0 0 1 .213.665l-.39 1.48c-.019.07-.048.141-.048.213 0 .32.26.58.57.58a.626.626 0 0 0 .314-.105l1.903-1.09a.58.58 0 0 1 .316-.09c.062 0 .124.01.18.026 1.004.279 2.096.433 3.231.433h.229a6.52 6.52 0 0 1-.097-.997c0-3.4 3.135-6.156 7.006-6.156h.229C16.618 4.911 13.017 2.188 8.691 2.188zm-2.6 4.408a.966.966 0 1 1 0-1.92.966.966 0 0 1 0 1.92zm5.189 0a.966.966 0 1 1 0-1.92.966.966 0 0 1 0 1.92zM24 15.364c0-3.404-3.388-6.157-7.559-6.157-4.17 0-7.557 2.753-7.557 6.157s3.388 6.157 7.557 6.157c.885 0 1.737-.123 2.527-.35a.48.48 0 0 1 .258.034l1.655.904a.534.534 0 0 0 .262.087.487.487 0 0 0 .484-.49c0-.087-.024-.16-.042-.235l-.324-1.243a.487.487 0 0 1 .181-.553C23.004 18.906 24 17.238 24 15.364zm-9.913-1.56a.822.822 0 1 1 0-1.645.822.822 0 0 1 0 1.646zm4.71 0a.822.822 0 1 1 0-1.645.822.822 0 0 1 0 1.646z"/></svg>
              <span>{t(locale, 'support.wechat')}</span>
            </span>
            <span class="font-mono text-xs">a39085417</span>
          </button>
        </div>
      </div>
    </div>

    <script>
      const supportBtn = document.getElementById('support-btn');
      const supportModal = document.getElementById('support-modal');
      const supportClose = document.getElementById('support-close');

      const openModal = () => {
        supportModal?.classList.remove('hidden');
        supportBtn?.setAttribute('aria-expanded', 'true');
      };
      const closeModal = () => {
        supportModal?.classList.add('hidden');
        supportBtn?.setAttribute('aria-expanded', 'false');
      };

      supportBtn?.addEventListener('click', (event) => {
        event.stopPropagation();
        if (supportModal?.classList.contains('hidden')) {
          openModal();
        } else {
          closeModal();
        }
      });

      supportClose?.addEventListener('click', closeModal);

      supportModal?.addEventListener('click', (event) => {
        if (event.target === supportModal) {
          closeModal();
        }
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          closeModal();
        }
      });

      const wechatBtn = document.getElementById('support-wechat');
      wechatBtn?.addEventListener('click', async () => {
        const wechatId = wechatBtn.getAttribute('data-wechat-id') ?? '';
        try {
          await navigator.clipboard.writeText(wechatId);
          wechatBtn.setAttribute('aria-label', t_copy_ok());
          showToast(t_copy_ok());
        } catch {
          showToast(t_copy_fail());
        }
      });

      function t_copy_ok() {
        return document.documentElement.lang === 'en' ? 'WeChat ID copied' : '微信号已复制';
      }
      function t_copy_fail() {
        return document.documentElement.lang === 'en' ? 'Copy failed — please copy manually' : '复制失败,请手动复制';
      }

      let toastTimer: ReturnType<typeof setTimeout> | undefined;
      function showToast(message: string) {
        let toast = document.getElementById('support-toast');
        if (!toast) {
          toast = document.createElement('div');
          toast.id = 'support-toast';
          toast.setAttribute('role', 'status');
          document.body.appendChild(toast);
        }
        toast.textContent = message;
        toast.classList.add('support-toast-visible');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => toast?.classList.remove('support-toast-visible'), 2000);
      }
    </script>

    <style>
      button.support-link {
        width: 100%;
        font: inherit;
        cursor: pointer;
        text-align: left;
      }

      #support-toast {
        position: fixed;
        bottom: 5.5rem;
        right: 1.25rem;
        z-index: 80;
        padding: 0.5rem 0.9rem;
        border-radius: 0.6rem;
        border: 1px solid var(--color-border);
        background: rgba(15, 23, 42, 0.88);
        color: #fff;
        font-size: 0.8rem;
        opacity: 0;
        transform: translateY(4px);
        pointer-events: none;
        transition: opacity 0.2s ease, transform 0.2s ease;
      }

      #support-toast.support-toast-visible {
        opacity: 1;
        transform: translateY(0);
      }
    </style>
  </body>
</html>
