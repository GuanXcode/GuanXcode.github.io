---
import type { CollectionEntry } from 'astro:content';
import type { SessionUser } from '../lib/auth';
import WorkCard from './WorkCard.astro';
import SectionIcon from './SectionIcon.astro';
import { t, withLocale, type Locale } from '../lib/i18n';

interface Props {
  user?: SessionUser;
  publicWorks: CollectionEntry<'works'>[];
  recentPosts: CollectionEntry<'blog'>[];
  privateWorkCount: number;
  locale?: Locale;
}

const {
  user,
  publicWorks,
  recentPosts,
  privateWorkCount,
  locale = 'zh',
} = Astro.props;

const skills = [
  {
    title: t(locale, 'skill.agent.title'),
    summary: t(locale, 'skill.agent.summary'),
    icon: 'timeline' as const,
    items: [
      t(locale, 'skill.agent.i0'),
      t(locale, 'skill.agent.i1'),
      t(locale, 'skill.agent.i2'),
      t(locale, 'skill.agent.i3'),
    ],
  },
  {
    title: t(locale, 'skill.rag.title'),
    summary: t(locale, 'skill.rag.summary'),
    icon: 'log' as const,
    items: [
      t(locale, 'skill.rag.i0'),
      t(locale, 'skill.rag.i1'),
      t(locale, 'skill.rag.i2'),
      t(locale, 'skill.rag.i3'),
    ],
  },
  {
    title: t(locale, 'skill.eval.title'),
    summary: t(locale, 'skill.eval.summary'),
    icon: 'skills' as const,
    items: [
      t(locale, 'skill.eval.i0'),
      t(locale, 'skill.eval.i1'),
      t(locale, 'skill.eval.i2'),
      t(locale, 'skill.eval.i3'),
    ],
  },
  {
    title: t(locale, 'skill.arch.title'),
    summary: t(locale, 'skill.arch.summary'),
    icon: 'projects' as const,
    items: [
      t(locale, 'skill.arch.i0'),
      t(locale, 'skill.arch.i1'),
      t(locale, 'skill.arch.i2'),
      t(locale, 'skill.arch.i3'),
    ],
  },
];

const heroTags = skills.map((s) => s.title);
const meHref = withLocale(locale, '/me/');
const researchHref = withLocale(locale, '/research/');
const projectsHref = withLocale(locale, '/projects/');
const projectsLoginHref = `${withLocale(locale, '/login')}?next=${encodeURIComponent(withLocale(locale, '/projects/'))}`;

const typeKeyMap = {
  demo: 'type.demo',
  design: 'type.design',
  talk: 'type.talk',
  article: 'type.article',
  repo: 'type.repo',
  other: 'type.other',
} as const;

function typeLabel(type: string) {
  const key = typeKeyMap[type as keyof typeof typeKeyMap];
  return key ? t(locale, key) : type;
}

function formatPostDate(date: Date) {
  return date.toLocaleDateString(locale === 'en' ? 'en-US' : 'zh-CN', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
}
---

<div class="home-landing">
  <section class="home-hero-stage" aria-label={t(locale, 'home.heroAria')}>
    <canvas class="home-hero-canvas" id="home-starfield" aria-hidden="true"></canvas>
    <div class="home-hero-stars home-hero-stars--far" aria-hidden="true"></div>
    <div class="home-hero-stars home-hero-stars--near" aria-hidden="true"></div>
    <div class="home-hero-grid" aria-hidden="true"></div>
    <div class="home-hero-glow" aria-hidden="true"></div>

    <div class="home-hero-inner">
      <p class="home-hero-hello">{t(locale, 'home.hello')}</p>
      <h1 class="home-hero-brand">AI Kosei</h1>
      <p class="home-hero-role">{t(locale, 'home.role')}</p>
      <p class="home-hero-lead">{t(locale, 'home.tagline')}</p>
      <p class="home-hero-desc">{t(locale, 'home.bio')}</p>

      <div class="home-hero-ctas">
        <a href={meHref} class="home-cta home-cta--primary">
          {user ? t(locale, 'home.cta.resumeAuthed') : t(locale, 'home.cta.resume')}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
        <a href={researchHref} class="home-cta home-cta--ghost">{t(locale, 'home.cta.research')}</a>
        <a href={projectsHref} class="home-cta home-cta--ghost">{t(locale, 'home.cta.projects')}</a>
      </div>

      {heroTags.length > 0 && (
        <div class="home-hero-tags">
          {heroTags.map((area) => (
            <span class="home-hero-tag">{area}</span>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="home-section" id="skills">
    <div class="home-section-inner">
      <header class="home-section-head">
        <h2 class="home-section-title">{t(locale, 'home.skillsTitle')}</h2>
        <p class="home-section-sub">{t(locale, 'home.skillsSub')}</p>
      </header>
      <div class="home-skill-grid">
        {skills.map((group) => (
          <article class="home-skill-card">
            <div class="home-skill-card-top">
              <span class="home-skill-icon" aria-hidden="true">
                <SectionIcon name={group.icon} class="w-4 h-4" />
              </span>
              <div>
                <h3 class="home-skill-title">{group.title}</h3>
                <p class="home-skill-summary">{group.summary}</p>
              </div>
            </div>
            <div class="home-skill-chips">
              {group.items.map((item) => (
                <span class="home-skill-chip">{item}</span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="home-section" id="projects">
    <div class="home-section-inner">
      <header class="home-section-head home-section-head--row">
        <div>
          <h2 class="home-section-title">{t(locale, 'home.worksTitle')}</h2>
          <p class="home-section-sub">{t(locale, 'home.worksSub')}</p>
        </div>
        <a href={projectsHref} class="home-section-more">
          {t(locale, 'home.worksMore')}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </header>
      {privateWorkCount > 0 && (
        <p class="home-section-note">
          {t(locale, 'home.worksPrivate', { n: privateWorkCount })}{' '}
          <a href={projectsLoginHref}>{t(locale, 'home.authLink')}</a>
        </p>
      )}
      {publicWorks.length > 0 ? (
        <div class="home-works-grid">
          {publicWorks.map((work) => (
            <WorkCard
              title={work.data.title}
              description={work.data.description}
              type={typeLabel(work.data.type)}
              typeKey={work.data.type}
              slug={work.id}
              url={work.data.url}
              publicBadge={work.data.visibility === 'public'}
            />
          ))}
        </div>
      ) : (
        <p class="home-empty">{t(locale, 'home.worksEmpty')}</p>
      )}
    </div>
  </section>

  <section class="home-section home-section--last" id="research">
    <div class="home-section-inner">
      <header class="home-section-head home-section-head--row">
        <div>
          <h2 class="home-section-title">{t(locale, 'home.researchTitle')}</h2>
          <p class="home-section-sub">{t(locale, 'home.researchSub')}</p>
        </div>
        <a href={researchHref} class="home-section-more">
          {t(locale, 'home.researchMore')}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </a>
      </header>
      {recentPosts.length > 0 ? (
        <div class="home-posts">
          {recentPosts.map((post) => (
            <a href={`/blog/${post.id}/`} class="home-post-card">
              <time class="home-post-date">{formatPostDate(post.data.date)}</time>
              <h3 class="home-post-title">{post.data.title}</h3>
              <p class="home-post-excerpt">
                {post.data.subtitle || post.body?.replace(/<[^>]*>/g, '').replace(/[#*>`\[\]()!]/g, '').trim().slice(0, 110)}
              </p>
              {post.data.tags?.length > 0 && (
                <div class="home-post-tags">
                  {post.data.tags.slice(0, 3).map((tag) => (
                    <span class="home-post-tag">{tag}</span>
                  ))}
                </div>
              )}
              <span class="home-post-read">{t(locale, 'home.readArticle')}</span>
            </a>
          ))}
        </div>
      ) : (
        <p class="home-empty">{t(locale, 'home.researchEmpty')}</p>
      )}
    </div>
  </section>
</div>

<script>
  function initHomeStarfield() {
    const canvas = document.getElementById('home-starfield');
    if (!(canvas instanceof HTMLCanvasElement)) return;
    if (canvas.dataset.ready === '1') return;
    canvas.dataset.ready = '1';

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const stage = canvas.parentElement;
    if (!stage) return;

    /** @type {{ x: number; y: number; r: number; vx: number; vy: number; a: number; tw: number; sp: number }[]} */
    let stars = [];
    let raf = 0;
    let running = false;

    function resize() {
      const rect = stage.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.max(1, Math.floor(rect.width * dpr));
      canvas.height = Math.max(1, Math.floor(rect.height * dpr));
      canvas.style.width = `${rect.width}px`;
      canvas.style.height = `${rect.height}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      seed(rect.width, rect.height);
    }

    function seed(w, h) {
      const count = Math.min(110, Math.max(48, Math.floor((w * h) / 14000)));
      stars = Array.from({ length: count }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        r: Math.random() * 1.4 + 0.4,
        vx: (Math.random() - 0.5) * 0.12,
        vy: -0.04 - Math.random() * 0.1,
        a: 0.25 + Math.random() * 0.7,
        tw: Math.random() * Math.PI * 2,
        sp: 0.8 + Math.random() * 1.6,
      }));
    }

    function drawStatic() {
      const w = canvas.clientWidth;
      const h = canvas.clientHeight;
      ctx.clearRect(0, 0, w, h);
      for (const s of stars) {
        ctx.beginPath();
        ctx.fillStyle = `rgba(125, 211, 252, ${s.a * 0.85})`;
        ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
        ctx.fill();
      }
    }

    function tick() {
      if (!running) return;
      const w = canvas.clientWidth;
      const h = canvas.clientHeight;
      ctx.clearRect(0, 0, w, h);

      for (const s of stars) {
        s.x += s.vx;
        s.y += s.vy;
        s.tw += 0.02 * s.sp;
        if (s.y < -4) {
          s.y = h + 4;
          s.x = Math.random() * w;
        }
        if (s.x < -4) s.x = w + 4;
        if (s.x > w + 4) s.x = -4;

        const pulse = 0.45 + 0.55 * Math.abs(Math.sin(s.tw));
        const alpha = s.a * pulse;
        ctx.beginPath();
        ctx.fillStyle = `rgba(186, 230, 253, ${alpha})`;
        ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
        ctx.fill();

        if (s.r > 1.1) {
          ctx.beginPath();
          ctx.fillStyle = `rgba(56, 189, 248, ${alpha * 0.35})`;
          ctx.arc(s.x, s.y, s.r * 2.2, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      raf = requestAnimationFrame(tick);
    }

    function start() {
      if (running) return;
      running = true;
      raf = requestAnimationFrame(tick);
    }

    function stop() {
      running = false;
      cancelAnimationFrame(raf);
    }

    resize();
    if (reduceMotion) {
      drawStatic();
    } else {
      start();
    }

    const onResize = () => {
      resize();
      if (reduceMotion) drawStatic();
    };
    window.addEventListener('resize', onResize);

    const onVisibility = () => {
      if (reduceMotion) return;
      if (document.hidden) stop();
      else start();
    };
    document.addEventListener('visibilitychange', onVisibility);
  }

  initHomeStarfield();
  document.addEventListener('astro:page-load', initHomeStarfield);
</script>
