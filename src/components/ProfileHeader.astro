---
import type { SessionUser } from '../lib/auth';

interface Props {
  user: SessionUser;
}

const { user } = Astro.props;
---

<section class="py-10">
  <div class="max-w-5xl mx-auto px-6">
    <div class="flex items-center gap-4">
      {user.avatar && (
        <img src={user.avatar} alt="" class="w-12 h-12 rounded-full border border-[var(--color-border)]" />
      )}
      <div class="min-w-0">
        <p class="hud-status">Session · Authorized</p>
        <h1 class="text-xl font-bold mt-1">欢迎，{user.name}</h1>
        <p class="text-sm text-[var(--color-text-secondary)] font-mono">@{user.login}</p>
      </div>
    </div>
  </div>
</section>
